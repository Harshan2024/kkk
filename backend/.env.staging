# ─────────────────────────────────────────────────────────────────────────────
# .env.staging — CarbonTracker AI Staging Environment
# ─────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=staging

# Database — Staging PostgreSQL (Neon / Render)
DATABASE_URL=postgresql://USER:PASSWORD@STAGING_HOST:5432/carbontracker_staging?sslmode=require

# JWT Authentication — use a strong random key
SECRET_KEY=REPLACE_WITH_64_CHAR_RANDOM_SECRET_KEY
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI
OPENAI_API_KEY=REPLACE_WITH_STAGING_API_KEY

# Alerts — enable warnings in staging
ALERT_MIN_LEVEL=warning
ALERT_SLACK_WEBHOOK_URL=
ALERT_DISCORD_WEBHOOK_URL=

# CORS — staging frontend URL
BACKEND_CORS_ORIGINS=https://carbontracker-staging.vercel.app,http://localhost:3000

# Feature Flags
ENABLE_AI_COACH=true
ENABLE_OCR=true
ENABLE_IOT=false
