# ─────────────────────────────────────────────────────────────────────────────
# .env.development — CarbonTracker AI Development Environment
# ─────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=development

# Database — Local PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/carbontracker

# JWT Authentication
SECRET_KEY=dev_only_secret_key_change_in_production_12345678
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# OpenAI (optional in dev)
OPENAI_API_KEY=

# Alerts (all disabled in dev)
ALERT_MIN_LEVEL=critical
ALERT_SLACK_WEBHOOK_URL=
ALERT_DISCORD_WEBHOOK_URL=
ALERT_TEAMS_WEBHOOK_URL=
ALERT_EMAIL_SMTP_HOST=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=
ALERT_EMAIL_PASSWORD=

# CORS (permissive in dev)
BACKEND_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Feature Flags
ENABLE_AI_COACH=true
ENABLE_OCR=true
ENABLE_IOT=false
