# ─────────────────────────────────────────────────────────────────────────────
# .env.production — CarbonTracker AI Production Environment
# ─────────────────────────────────────────────────────────────────────────────
# CRITICAL: Never commit real values to version control.
# Use GitHub Secrets / Railway Secrets / Render Environment Variables.
# ─────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=production

# Database — Production PostgreSQL (Neon / Supabase / Render)
DATABASE_URL=postgresql://USER:PASSWORD@PRODUCTION_HOST:5432/carbontracker?sslmode=require&channel_binding=require

# JWT Authentication — MUST be a cryptographically random 64+ char string
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_PRODUCTION_SECRET_KEY

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# OpenAI
OPENAI_API_KEY=REPLACE_WITH_PRODUCTION_API_KEY

# Alerts — enable error and critical alerts in production
ALERT_MIN_LEVEL=error
ALERT_SLACK_WEBHOOK_URL=REPLACE_WITH_SLACK_WEBHOOK
ALERT_DISCORD_WEBHOOK_URL=
ALERT_TEAMS_WEBHOOK_URL=
ALERT_EMAIL_SMTP_HOST=smtp.gmail.com
ALERT_EMAIL_SMTP_PORT=587
ALERT_EMAIL_FROM=alerts@yourdomain.com
ALERT_EMAIL_TO=oncall@yourdomain.com
ALERT_EMAIL_PASSWORD=REPLACE_WITH_APP_PASSWORD

# CORS — production frontend domain
BACKEND_CORS_ORIGINS=https://carbontracker.vercel.app,https://www.carbontracker.ai

# PostgreSQL Direct (for scripts)
POSTGRES_DB=carbontracker
POSTGRES_USER=REPLACE_WITH_DB_USER
POSTGRES_PASSWORD=REPLACE_WITH_DB_PASSWORD

# Feature Flags
ENABLE_AI_COACH=true
ENABLE_OCR=true
ENABLE_IOT=false
